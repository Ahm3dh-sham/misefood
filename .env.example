# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://misefood:misefood_password@localhost:5432/misefood_db

# Google Gemini API Configuration (google-genai >= 2.25.0)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
